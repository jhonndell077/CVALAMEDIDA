{
  "functions": {
    "source": ".",
    "codebase": "default",
    "runtime": "python313",
    "predeploy": [
      "python generate_manifest.py"
    ],
    "ignore": [
      ".git",
      ".venv",
      "venv",
      "node_modules",
      "package.json",
      "package-lock.json",
      "__pycache__",
      "firebase-debug.log",
      "tests",
      "tmp",
      "auditoria",
      "*.pdf",
      "*.docx",
      "data/knowledge_map.json",
      "gha-creds-*.json",
      ".github",
      "scripts",
      "docs",
      "Deploy.ps1"
    ]
  },
  "hosting": [
    {
      "predeploy": [
        "python generate_version.py"
      ],
      "public": "static",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "/admin/arquitectura{,/**}",
          "destination": "/admin-architecture.html"
        },
        {
          "source": "/admin/funcionamiento{,/**}",
          "destination": "/admin-functionality.html"
        },
        {
          "source": "/admin/conexiones{,/**}",
          "destination": "/admin-connections.html"
        },
        {
          "source": "/telegram/**",
          "function": {
            "functionId": "api",
            "region": "us-central1"
          }
        },
        {
          "source": "/api/**",
          "function": {
            "functionId": "api",
            "region": "us-central1"
          }
        }
      ],
      "headers": [
        {
          "source": "**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-store"
            },
            {
              "key": "Content-Security-Policy",
              "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; script-src 'self' https://www.gstatic.com https://accounts.google.com https://apis.google.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.googleusercontent.com https://*.tile.openstreetmap.org; connect-src 'self' https://*.googleapis.com https://accounts.google.com https://*.firebaseapp.com https://www.gstatic.com; frame-src https://*.google.com https://*.firebaseapp.com; font-src 'self'; form-action 'self'"
            },
            {
              "key": "X-Frame-Options",
              "value": "DENY"
            },
            {
              "key": "X-Content-Type-Options",
              "value": "nosniff"
            },
            {
              "key": "Referrer-Policy",
              "value": "strict-origin-when-cross-origin"
            },
            {
              "key": "Cross-Origin-Opener-Policy",
              "value": "same-origin-allow-popups"
            },
            {
              "key": "Permissions-Policy",
              "value": "camera=(), microphone=(), geolocation=(self)"
            }
          ]
        }
      ],
      "site": "cv-a-la-medida-jhonn"
    },
    {
      "predeploy": [
        "python generate_version.py"
